PORT=7000
LOG_LEVEL=info
ANILIST_URL=https://graphql.anilist.co
ANILIST_RATE_LIMIT=25
HTTP_TIMEOUT_MS=3500
CACHE_MAX_ENTRIES=10000

# Optional. Leave empty to run with no artwork enrichment at all — the add-on
# behaves exactly as it did without it. Get a key at
# https://www.themoviedb.org/settings/api (a free v3 API key).
# TMDB_API_KEY=
